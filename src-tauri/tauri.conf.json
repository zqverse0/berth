{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "berth",
  "version": "0.39.1",
  "mainBinaryName": "berth-gui",
  "identifier": "app.berth",
  "build": {
    "beforeDevCommand": "pnpm tauri:before-dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm tauri:before-build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": [
        "style-src",
        "script-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/berth-cli"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libgtk-4-1",
          "libnss3",
          "libnspr4",
          "libgbm1",
          "libasound2t64 | libasound2",
          "libcups2t64 | libcups2",
          "libatk1.0-0t64 | libatk1.0-0",
          "libatk-bridge2.0-0t64 | libatk-bridge2.0-0",
          "libatspi2.0-0t64 | libatspi2.0-0",
          "libdbus-1-3"
        ]
      },
      "rpm": {
        "depends": [
          "gtk4",
          "nss",
          "nspr",
          "mesa-libgbm",
          "alsa-lib",
          "cups-libs",
          "at-spi2-atk",
          "at-spi2-core",
          "dbus-libs"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ5MkNCQzUwMEMyQjEwNzAKUldSd0VDc01VTHdzU2ZzL0lSMzBEKzNLTTIxRG8wSFlCeXZSbjJWZVZ3VVhCS0FsbWNnTmlISzQK",
      "endpoints": [
        "https://github.com/zqverse0/berth/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
