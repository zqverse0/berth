[
  {
    "id": "deepseek",
    "matchHosts": [
      "api.deepseek.com"
    ],
    "declaration": {
      "label": "DeepSeek balance",
      "request": {
        "method": "GET",
        "url": "https://api.deepseek.com/user/balance",
        "headers": {
          "Accept": "application/json"
        }
      },
      "windows": [
        {
          "id": "balance",
          "label": "Balance",
          "remainingPointers": [
            "/balance_infos/0/total_balance"
          ],
          "valueScale": 1,
          "unit": "CNY"
        }
      ],
      "credential": {
        "kind": "json-file",
        "tokenPointer": "/unused"
      }
    }
  },
  {
    "id": "stepfun",
    "matchHosts": [
      "api.stepfun.com",
      "api.stepfun.ai"
    ],
    "declaration": {
      "label": "StepFun balance",
      "request": {
        "method": "GET",
        "url": "https://api.stepfun.com/v1/accounts",
        "headers": {
          "Accept": "application/json"
        }
      },
      "windows": [
        {
          "id": "balance",
          "label": "Balance",
          "remainingPointers": [
            "/balance"
          ],
          "valueScale": 1,
          "unit": "CNY"
        }
      ],
      "credential": {
        "kind": "json-file",
        "tokenPointer": "/unused"
      }
    }
  },
  {
