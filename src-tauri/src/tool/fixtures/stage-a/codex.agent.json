{
  "name": "Codex CLI",
  "command": "codex",
  "icon": "codex",
  "description": "OpenAI Codex CLI and its user/project configuration.",
  "projectType": "codex",
  "baseArgs": [],
  "providerInjection": {
    "agentType": "codex",
    "official": {
      "label": "OpenAI Official",
      "website": "https://chatgpt.com/codex",
      "models": [
        {
          "name": "GPT-5.6-Sol",
          "id": "gpt-5.6-sol"
        },
        {
          "name": "GPT-5.6-Terra",
          "id": "gpt-5.6-terra"
        },
        {
          "name": "GPT-5.6-Luna",
          "id": "gpt-5.6-luna"
        },
        {
          "name": "GPT-5.5",
          "id": "gpt-5.5"
        },
        {
          "name": "GPT-5.4",
          "id": "gpt-5.4"
        },
        {
          "name": "GPT-5.4-Mini",
          "id": "gpt-5.4-mini"
        },
        {
          "name": "GPT-5.2",
          "id": "gpt-5.2"
        }
      ]
    },
    "env": {
      "BERTH_CODEX_API_KEY": "$api_key"
    },
    "argv": [
      "-c",
      "model_provider=berth",
      "-c",
      "model_providers.berth.name=berth",
      "-c",
      "model_providers.berth.base_url=$api_url",
      "-c",
      "model_providers.berth.env_key=BERTH_CODEX_API_KEY"
    ]
  },
  "expertDeployment": {
    "root": ".codex",
    "instructionFile": "AGENTS.md",
    "skillsDir": "skills"
  },
  "capabilityStores": {
    "mcp": {
      "path": "~/.codex/config.toml",
      "format": "codex-mcp-v1"
    },
    "skills": {
      "searchPaths": [
        "~/.codex/skills"
      ],
      "projectSearchPaths": [
        ".codex/skills",
        ".agents/skills"
      ],
      "shared": [
        "~/.agents/skills"
      ],
      "store": "~/.berth/skills"
    }
  }
}
