# Logs
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
tsconfig.tsbuildinfo

# Next.js
.next/
out/
next-env.d.ts

# PDF.js local assets (regenerated by scripts/sync-pdfjs-assets.mjs on
# postinstall and build; the script rmSync's the whole dir each run).
public/pdfjs
public/excalidraw

# Scraped reference docs (not project source)
docs.langchain.com/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Test artifacts
coverage/
*.snap.new
.vitest-cache/

# macOS signing material. Keep certificates and exported private keys out of git.
*.cer
*.csr
*.p12
certificate-base64.txt

# Agent
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/project-knowledge
.docs
docs/superpowers
.agent
# Agent hosts may create local files under `.agents`; keep those ignored while
# allowing the project knowledge skill below to be versioned (`.claude/skills`
# links to it).
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/project-knowledge/
!.agents/skills/project-knowledge/**
.codex
.cursor
.codegraph
.pi/


# Tauri sidecar staging (built per-target by prepare-sidecars.mjs).
# The binaries are platform-specific build artifacts; ship them through
# release.yml, not git.
src-tauri/binaries/

# pnpm local store (pnpm 11+)
.pnpm-store/

# Local release artifacts
outputs/

# Temporary workspace / scratch area
work/

# Committed vendored browser-side bundles (defuddle IIFE for the web reader).
!src/vendor/
!src/vendor/**
.cache/

__pycache__/

# 本地归档区（见 REMOVE/README.md），不进 git
REMOVE/
