{
  "storage": "json",
  "path": "~/.cline/data/sessions",
  "files": "**/{@path.parent.name}.messages.json",
  "locate": "**/{id}/{id}.messages.json",
  "records": "/messages",
  "sessionDocument": "{@path.parent.name}.json",
  "session": {
    "id": "/session_id",
    "project": [
      "/cwd",
      "/workspace_root"
    ],
    "title": "/prompt",
    "model": "/model",
    "time": "/started_at"
  },
  "message": {
    "id": "/id",
    "role": "/role",
    "content": "/content",
    "model": "/modelInfo/id",
    "time": "/ts"
  },
  "tools": {
    "run_commands": {
      "kind": "command",
      "items": "/commands",
      "command": ""
    },
    "editor": {
      "kind": "edit",
      "path": "/path",
      "old": "/old_text",
      "new": "/new_text"
    },
    "edit_files": {
      "kind": "edit",
      "path": "/path",
      "old": "/old_text",
      "new": "/new_text"
    },
    "read_files": {
      "kind": "read",
      "items": "/files",
      "path": "/path"
    },
    "search_codebase": {
      "kind": "search",
      "items": "/queries",
      "text": ""
    },
    "ask_question": {
      "kind": "question",
      "text": "/question"
    },
    "spawn_agent": {
      "kind": "delegate",
      "text": "/task"
    },
    "skills": {
      "kind": "skill",
      "title": "/skill"
    }
  }
}
