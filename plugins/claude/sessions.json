{
  "storage": "jsonl",
  "path": "~/.claude/projects",
  "files": "**/*.jsonl",
  "locate": "**/{id}.jsonl",
  "session": {
    "record": "user",
    "id": "/sessionId",
    "project": "/cwd",
    "time": "/timestamp"
  },
  "message": {
    "record": [
      "user",
      "assistant"
    ],
    "value": "/message",
    "role": "/role",
    "content": "/content",
    "model": "/model",
    "time": "/timestamp",
    "usage": "/usage",
    "injected": {
      "flag": "/isMeta",
      "textPrefixes": [
        "<local-command-caveat>",
        "<local-command-stdout>",
        "<command-name>",
        "This session is being continued from a previous conversation",
        "[Request interrupted"
      ]
    }
  },
  "skills": {
    "toolNames": [
      "Skill"
    ],
    "nameKey": "skill"
  },
  "context": [
    {
      "source": "system",
      "record": "prompt_snapshot",
      "kind": "/attachment/type",
      "text": "/attachment/systemPrompt"
    },
    {
      "source": "instructions",
      "record": "instructions",
      "kind": "/attachment/type",
      "items": "/attachment/files",
      "name": "/path",
      "path": "/path",
      "text": "/content"
    },
    {
      "source": "skills",
      "record": "skill_listing",
      "kind": "/attachment/type",
      "text": "/attachment/content"
    },
    {
      "source": "mcp",
      "record": "mcp_instructions_delta",
      "kind": "/attachment/type",
      "text": "/attachment/addedBlocks"
    },
    {
      "source": "agents",
      "record": "agent_listing_delta",
      "kind": "/attachment/type",
      "text": "/attachment/addedLines"
    },
    {
      "source": "hook",
      "record": "hook_success",
      "kind": "/attachment/type",
      "name": "/attachment/hookName",
      "text": "/attachment/content"
    },
    {
      "source": "environment",
      "record": "session_context",
      "kind": "/attachment/type",
      "text": "/attachment/context"
    }
  ],
  "tools": {
    "Bash": {
      "kind": "command",
      "command": "/command",
      "title": "/description",
      "background": "/run_in_background"
    },
    "Monitor": {
      "kind": "command",
      "command": "/command",
      "title": "/description"
    },
    "Read": {
      "kind": "read",
      "path": "/file_path"
    },
    "Edit": {
      "kind": "edit",
      "path": "/file_path",
      "old": "/old_string",
      "new": "/new_string"
    },
    "MultiEdit": {
      "kind": "edit",
      "items": "/edits",
      "path": "/file_path",
      "old": "/old_string",
      "new": "/new_string"
    },
    "Write": {
      "kind": "edit",
      "path": "/file_path",
      "new": "/content"
    },
    "NotebookEdit": {
      "kind": "edit",
      "path": "/notebook_path",
      "new": "/new_source"
    },
    "Grep": {
      "kind": "search",
      "title": "/pattern",
      "path": "/path"
    },
    "Glob": {
      "kind": "search",
      "title": "/pattern",
      "path": "/path"
    },
    "WebFetch": {
      "kind": "fetch",
      "title": "/url"
    },
    "WebSearch": {
      "kind": "fetch",
      "title": "/query"
    },
    "TodoWrite": {
      "kind": "plan",
      "items": "/todos",
      "text": "/content",
      "status": "/status"
    },
    "AskUserQuestion": {
      "kind": "question",
      "items": "/questions",
      "text": "/question"
    },
    "Task": {
      "kind": "delegate",
      "title": "/description",
      "text": "/prompt"
    },
    "Agent": {
      "kind": "delegate",
      "title": "/description",
      "text": "/prompt"
    },
    "Skill": {
      "kind": "skill",
      "title": "/skill"
    },
    "ExitPlanMode": {
      "kind": "think",
      "text": "/plan"
    }
  }
}
