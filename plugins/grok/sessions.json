{
  "storage": "jsonl",
  "path": "~/.grok/sessions",
  "files": "**/chat_history.jsonl",
  "locate": "**/{id}/chat_history.jsonl",
  "session": {
    "record": "system",
    "id": "@path.parent.name",
    "project": "@path.parent.parent.url_decode.name"
  },
  "message": {
    "variant": "/type",
    "roleMap": {
      "system": "system",
      "user": "user",
      "assistant": "assistant",
      "reasoning": "assistant",
      "tool_result": "tool"
    },
    "content": [
      "/content",
      "/summary"
    ],
    "model": "/model_id",
    "tool_calls": "/tool_calls",
    "tool_use_id": [
      "/tool_call_id",
      "/toolCallId"
    ],
    "tool_output": "/content"
  },
  "context": [
    {
      "source": "system",
      "record": "system",
      "text": "/content"
    },
    {
      "source": "environment",
      "record": "user",
      "text": "/content",
      "textPrefixes": [
        "<user_info>"
      ]
    },
    {
      "source": "skills",
      "record": "user",
      "text": "/content",
      "textPrefixes": [
        "<system-reminder>\n## Available Skills",
        "<system-reminder>\nThe following skills are available"
      ]
    },
    {
      "source": "tools",
      "record": "user",
      "text": "/content",
      "textPrefixes": [
        "<system-reminder>\n\nCall `search_tool`"
      ]
    },
    {
      "source": "summary",
      "record": "user",
      "text": "/content",
      "textPrefixes": [
        "This session is being continued from a previous conversation"
      ]
    }
  ],
  "tools": {
    "run_terminal_command": {
      "kind": "command",
      "command": "/command",
      "title": "/description",
      "background": "/background"
    },
    "monitor": {
      "kind": "command",
      "command": "/command",
      "title": "/description"
    },
    "read_file": {
      "kind": "read",
      "path": "/target_file"
    },
    "search_replace": {
      "kind": "edit",
      "path": "/file_path",
      "old": "/old_string",
      "new": "/new_string"
    },
    "write": {
      "kind": "edit",
      "path": "/file_path",
      "new": "/content"
    },
    "grep": {
      "kind": "search",
      "title": "/pattern",
      "path": "/path"
    },
    "list_dir": {
      "kind": "search",
      "path": "/target_directory"
    },
    "search_tool": {
      "kind": "search",
      "title": "/query"
    },
    "web_fetch": {
      "kind": "fetch",
      "title": "/url"
    },
    "todo_write": {
      "kind": "plan",
      "items": "/todos",
      "text": "/content",
      "status": "/status"
    },
    "ask_user_question": {
      "kind": "question",
      "items": "/questions",
      "text": "/question"
    },
    "spawn_subagent": {
      "kind": "delegate",
      "title": "/description",
      "text": "/prompt"
    }
  }
}
