{
  "$schema": "urn:berth:tool-asset:1",
  "protocol": "berth.tool/1",
  "id": "tailscale",
  "version": "1.0.0",
  "engines": {
    "berth": ">=0.37"
  },
  "contributes": {
    "identity": {
      "name": "Tailscale",
      "roles": [],
      "tags": ["cli", "network", "ssh", "devices"],
      "description": "Private network between your devices. Agents use it to see which devices are online, drive Berth on another device over SSH (terminals, agents, tasks) and copy files.",
      "homepage": "https://tailscale.com"
    },
    "install": {
      "bin": "tailscale",
      "paths": {
        "unix": ["/usr/bin/tailscale", "/usr/local/bin/tailscale"],
        "windows": ["%ProgramFiles%/Tailscale/tailscale.exe"]
      },
      "version": ["version"]
    }
  },
  "resources": {},
  "knowledge": {
    "berth-loop": {
      "kind": "guide",
      "title": "Working across devices",
      "path": "usage.md"
    }
  }
}
